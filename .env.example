# Copy to .env (read by both Next.js and the Prisma CLI) and fill in.
# On Vercel you don't need to set anything by hand: Storage -> Create Database -> Neon
# adds the database variables, and the rest is optional. See README "Deploying to Vercel".

# Neon pooled connection string (used by the app at runtime). Host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection string (used by the Prisma CLI for migrations and seeding).
# Optional: falls back to DATABASE_URL_UNPOOLED (set by the Vercel Neon integration), then DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js secret for signing sessions. Generate with: npx auth secret  (or: openssl rand -base64 32)
# Optional: derived from the database URL when empty. Setting it is recommended.
AUTH_SECRET=""

# Protects the cron routes (/api/cron/recurring and /api/cron/reset-demo).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
# Optional: without it the cron jobs don't run; the app still works.
CRON_SECRET=""

# Only when running `npm start` outside Vercel (local production build, self-hosting):
# AUTH_TRUST_HOST=true
