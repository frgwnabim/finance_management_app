# Neon pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth.js secret. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""
